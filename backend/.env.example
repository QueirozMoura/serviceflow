NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://serviceflow:change-me@localhost:5432/serviceflow?schema=public
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=1 minute
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=serviceflow_session
AUTH_COOKIE_SAME_SITE=lax
# Numero de proxies reversos a confiar (IP real via X-Forwarded-For): false | true | inteiro.
TRUST_PROXY=false

# E-mail transacional (recuperacao de senha). Sem MAIL_PROVIDER nenhum e-mail e enviado e a recuperacao fica inoperante.
#   resend = API do Resend (exige RESEND_API_KEY e MAIL_FROM com um remetente de dominio verificado no provedor)
#   outbox = memoria, SO fora de producao: as mensagens ficam em GET /api/dev/mail-outbox (nada e enviado)
# MAIL_PROVIDER=outbox
# RESEND_API_KEY=re_change-me
# MAIL_FROM=ServiceFlow <no-reply@example.com>
# Origem do frontend usada nos links dos e-mails (padrao: a primeira CORS_ORIGIN).
# APP_BASE_URL=http://localhost:3000

# Google OAuth (opcional em dev). Se definir GOOGLE_CLIENT_ID, defina todas.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=change-me
# GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard
# OAUTH_FAILURE_REDIRECT=http://localhost:3000/login

# Producao (nao comitar valores reais):
# NODE_ENV=production
# HOST=0.0.0.0
# CORS_ORIGIN=https://serviceflow-wine-seven.vercel.app (obrigatorio: origem real, sem localhost)
# DATABASE_URL com credenciais reais e SSL quando exigido pelo provedor
# AUTH_COOKIE_SAME_SITE=none quando frontend e API ficam em sites diferentes (exige HTTPS)
# TRUST_PROXY=1 atras de um proxy reverso (obrigatorio para o rate limit usar o IP real)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=(segredo - configurar apenas no Render)
# GOOGLE_REDIRECT_URI=https://serviceflow-15yc.onrender.com/api/auth/google/callback
# OAUTH_SUCCESS_REDIRECT=https://serviceflow-wine-seven.vercel.app/dashboard
# OAUTH_FAILURE_REDIRECT=https://serviceflow-wine-seven.vercel.app/login

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://serviceflow:change-me@localhost:5432/serviceflow?schema=public
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=serviceflow_session
AUTH_COOKIE_SAME_SITE=lax

# Producao (nao comitar valores reais):
# NODE_ENV=production
# HOST=0.0.0.0
# CORS_ORIGIN=https://app.exemplo.com (obrigatorio: origem real, sem localhost)
# DATABASE_URL com credenciais reais e SSL quando exigido pelo provedor
# AUTH_COOKIE_SAME_SITE=none quando frontend e API ficam em sites diferentes (exige HTTPS)
